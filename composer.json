{
  "name": "a-gautrot/propel-json-behavior",
  "description": "Integration of JSON query filters in Propel, inspired by Laravel's JSON where clauses",
  "type": "propel-behavior",
  "license": "MIT",
  "keywords": ["propel", "behavior", "json"],
  "authors": [
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com"
    }
  ],
  "require": {
    "php": "^7.4||>=8.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "propel/propel": "~2.0.0-beta4||^2.0",
    "symfony/polyfill-php80": "^1.33",
    "symfony/polyfill-php81": "^1.33",
    "symfony/polyfill-php82": "^1.33",
    "symfony/polyfill-php83": "^1.33",
    "symfony/polyfill-php84": "^1.33",
    "symfony/polyfill-php85": "^1.33",
    "symfony/polyfill-php86": "^1.34"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "mikey179/vfsstream": "^1.6",
    "phpstan/phpstan": "@stable",
    "phpunit/phpunit": ">=9.6.33",
    "rector/rector": "^2.8",
    "squizlabs/php_codesniffer": "@stable",
    "vimeo/psalm": "@stable"
  },
  "autoload": {
    "psr-4": {
      "Gautrot\\Propel\\Behavior\\Json\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gautrot\\Propel\\Behavior\\Json\\Tests\\": "tests/"
    }
  },
  "extra": {
    "name": "json",
    "class": "\\Gautrot\\Propel\\Behavior\\Json\\JsonBehavior",
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "scripts": {
    "test": "@php tests/run.php",
    "test:coverage": "@test --coverage-clover tests/coverage.xml --coverage-text --log-junit tests/junit.xml",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
    "psalm": "vendor/bin/psalm --config=psalm.dist.xml",
    "phpcs": "phpcs --standard=PSR2 src",
    "rector": "rector process --config=rector.php --dry-run",
    "rector:fix": "rector process --config=rector.php"
  }
}
